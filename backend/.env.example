# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=greenstone

# --- Auth ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Admin account created on first run. CHANGE the default password before going live.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- URLs ---
SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- LLM providers for AI auto-blogging (set at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: override which model each provider uses
AUTOBLOG_OPENAI_MODEL=gpt-4o
AUTOBLOG_ANTHROPIC_MODEL=claude-sonnet-5
AUTOBLOG_GEMINI_MODEL=gemini-2.0-flash

# --- SMTP for outgoing email (inquiry notifications) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=PT. Murfy Alam Indonesia
EMAIL_REPLY_TO=sales@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com
