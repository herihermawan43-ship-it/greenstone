# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=greenstone

# --- Auth ---
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Admin account created on first run. CHANGE the default password before going live.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- URLs ---
SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- LLM providers for AI auto-blogging & SMTP for outgoing email ---
# All of the values below are OPTIONAL here: they can instead be set from
# Admin > Settings in the dashboard, which stores them encrypted in the
# database. Anything left blank in Admin > Settings falls back to the value
# below. Leave everything below blank if you plan to configure it entirely
# through the admin panel.

# LLM providers (set at least one, either here or in Admin > Settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AUTOBLOG_OPENAI_MODEL=gpt-4o
AUTOBLOG_ANTHROPIC_MODEL=claude-sonnet-5
AUTOBLOG_GEMINI_MODEL=gemini-2.0-flash

# SMTP for outgoing email (inquiry notifications)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=PT. Murfy Alam Indonesia
EMAIL_REPLY_TO=sales@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com
